# Configuração de referência da futura API REST (Spring Boot).
#
# O navegador não lê este arquivo automaticamente: arquivos .env não são
# seguros para segredos e o front-end estático não possui etapa de build.
# Copie os valores para window.LF_API_CONFIG antes de carregar os módulos da
# aplicação (por exemplo, em um <script> no <head>):
#
#   <script>
#     window.LF_API_CONFIG = {
#       baseUrl: 'http://localhost:8080/api',
#       timeoutMs: 10000,
#       credentials: 'include',
#       headers: {}
#     }
#   </script>
#
# As rotas REST também precisam ser confirmadas pelo contrato do Spring Boot.
# Mapeie apenas as chaves utilizadas em js/services/api/index.js:
#
#   window.LF_API_ENDPOINTS = {
#     'clientes.listar': '/clientes',
#     'clientes.obter': '/clientes/{id}'
#   }
#
# Sem essas configurações, a interface permanece em estado "sem integração" e
# nenhuma requisição é executada.

LF_API_BASE_URL=http://localhost:8080/api
LF_API_TIMEOUT_MS=10000
