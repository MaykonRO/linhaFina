{
  "info": {
    "_postman_id": "4d6f50d0-1e8f-4f6b-a2b0-linha-fina-mvp",
    "name": "Linha Fina — MVP",
    "description": "Coleção do MVP com autenticação, clientes e ordens de serviço.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Autenticação",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"senha\": \"{{senha_admin}}\"\n}"},
            "url": {"raw": "{{baseUrl}}/autenticacao/entrar", "host": ["{{baseUrl}}"], "path": ["autenticacao", "entrar"]}
          },
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Login realizado', function () { pm.response.to.have.status(200); });"]}}]
        },
        {
          "name": "Sessão atual",
          "request": {"method": "GET", "url": {"raw": "{{baseUrl}}/autenticacao/sessao", "host": ["{{baseUrl}}"], "path": ["autenticacao", "sessao"]}}
        },
        {
          "name": "Logout",
          "request": {"method": "POST", "url": {"raw": "{{baseUrl}}/autenticacao/sair", "host": ["{{baseUrl}}"], "path": ["autenticacao", "sair"]}}
        }
      ]
    },
    {
      "name": "02 Clientes",
      "item": [
        {
          "name": "Listar clientes",
          "request": {"method": "GET", "url": {"raw": "{{baseUrl}}/clientes", "host": ["{{baseUrl}}"], "path": ["clientes"]}}
        },
        {
          "name": "Criar cliente de teste",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"nome\": \"Cliente Postman Teste\",\n  \"telefone\": \"11999999999\",\n  \"email\": \"postman@teste.local\"\n}"},
            "url": {"raw": "{{baseUrl}}/clientes", "host": ["{{baseUrl}}"], "path": ["clientes"]}
          },
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Cliente criada', function () {", "  pm.response.to.have.status(201);", "  pm.environment.set('cliente_id', pm.response.json().id);", "});"]}}]
        },
        {
          "name": "Consultar cliente",
          "request": {"method": "GET", "url": {"raw": "{{baseUrl}}/clientes/{{cliente_id}}", "host": ["{{baseUrl}}"], "path": ["clientes", "{{cliente_id}}"]}}
        },
        {
          "name": "Editar cliente",
          "request": {
            "method": "PUT",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"nome\": \"Cliente Postman Editada\",\n  \"telefone\": \"11988887777\",\n  \"email\": \"postman@teste.local\"\n}"},
            "url": {"raw": "{{baseUrl}}/clientes/{{cliente_id}}", "host": ["{{baseUrl}}"], "path": ["clientes", "{{cliente_id}}"]}
          }
        },
        {
          "name": "Excluir cliente",
          "request": {"method": "DELETE", "url": {"raw": "{{baseUrl}}/clientes/{{cliente_id}}", "host": ["{{baseUrl}}"], "path": ["clientes", "{{cliente_id}}"]}}
        }
      ]
    },
    {
      "name": "03 Ordens de Serviço",
      "item": [
        {
          "name": "Listar OSs",
          "request": {"method": "GET", "url": {"raw": "{{baseUrl}}/ordens-servico", "host": ["{{baseUrl}}"], "path": ["ordens-servico"]}}
        },
        {
          "name": "Criar OS",
          "event": [{"listen": "prerequest", "script": {"type": "text/javascript", "exec": ["pm.environment.set('hoje', new Date().toISOString().slice(0, 10));"]}}],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"clienteId\": \"{{cliente_id}}\",\n  \"descricaoServico\": \"Ajuste de vestido para teste\",\n  \"valor\": 100,\n  \"dataEntrada\": \"{{hoje}}\",\n  \"dataPrevistaEntrega\": \"{{hoje}}\",\n  \"status\": \"pendente\"\n}"},
            "url": {"raw": "{{baseUrl}}/ordens-servico", "host": ["{{baseUrl}}"], "path": ["ordens-servico"]}
          },
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('OS criada', function () {", "  pm.response.to.have.status(201);", "  pm.environment.set('os_id', pm.response.json().id);", "});"]}}]
        },
        {
          "name": "Consultar OS",
          "request": {"method": "GET", "url": {"raw": "{{baseUrl}}/ordens-servico/{{os_id}}", "host": ["{{baseUrl}}"], "path": ["ordens-servico", "{{os_id}}"]}}
        },
        {
          "name": "Editar OS e status",
          "event": [{"listen": "prerequest", "script": {"type": "text/javascript", "exec": ["pm.environment.set('hoje', new Date().toISOString().slice(0, 10));"]}}],
          "request": {
            "method": "PUT",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"clienteId\": \"{{cliente_id}}\",\n  \"descricaoServico\": \"Ajuste de vestido editado\",\n  \"valor\": 120,\n  \"dataEntrada\": \"{{hoje}}\",\n  \"dataPrevistaEntrega\": \"{{hoje}}\",\n  \"status\": \"em_andamento\"\n}"},
            "url": {"raw": "{{baseUrl}}/ordens-servico/{{os_id}}", "host": ["{{baseUrl}}"], "path": ["ordens-servico", "{{os_id}}"]}
          }
        },
        {
          "name": "Excluir OS",
          "request": {"method": "DELETE", "url": {"raw": "{{baseUrl}}/ordens-servico/{{os_id}}", "host": ["{{baseUrl}}"], "path": ["ordens-servico", "{{os_id}}"]}}
        }
      ]
    }
  ],
  "variable": [
    {"key": "baseUrl", "value": "http://localhost:8080/api"},
    {"key": "admin_email", "value": "linha-fina@gmail.com"},
    {"key": "senha_admin", "value": ""},
    {"key": "cliente_id", "value": ""},
    {"key": "os_id", "value": ""},
    {"key": "hoje", "value": ""}
  ]
}
